{
  "name": "capsule-change-windows",
  "version": "0.1.0-alpha.1",
  "description": "Calendar, ChangeWindow overview, and active maintenance windows for Headlamp.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "lint": "headlamp-plugin lint",
    "lint:fix": "headlamp-plugin lint --fix",
    "format": "prettier src e2e playwright.config.ts vitest.config.mts",
    "tsc": "headlamp-plugin tsc",
    "test": "vitest run --config vitest.config.mts",
    "test:browser": "playwright test",
    "bench": "vitest bench --run --config vitest.config.mts",
    "check": "npm run lint && npm run format -- --check && npm run tsc && npm test && npm run build",
    "package": "headlamp-plugin package"
  },
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "overrides": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0",
    "@playwright/test": "1.64.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "cron-parser": "5.10.2"
  },
  "headlamp": {
    "extraDist": {
      "package.json": "package.json",
      "LICENSE": "../LICENSE"
    }
  }
}
